<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gradient Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/register_header_gradient"
            android:padding="24dp"
            android:gravity="bottom|center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Member Registration"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Registration Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/register_card_bg"
            android:padding="24dp"
            android:elevation="10dp"
            android:layout_margin="20dp"
            android:layout_marginTop="-60dp">

            <!-- Input Fields -->
            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="First Name"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etMiddleInitial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Middle Initial"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Last Name"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etDateHired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date Hired (YYYY-MM-DD)"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etBasicSalary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Basic Salary"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:padding="16dp"
                android:background="@drawable/input_field_bg"
                android:layout_marginBottom="24dp"/>

            <!-- Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Register"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#1A237E"
                app:cornerRadius="14dp"
                app:elevation="8dp"/>

            <!-- Display Employee ID after successful registration -->
            <TextView
                android:id="@+id/tvEmployeeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>