<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/dashboard_header_gradient"
            android:padding="24dp"
            android:gravity="bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABC Credit Cooperative"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Welcome Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/dashboard_card_bg"
            android:padding="22dp"
            android:elevation="10dp"
            android:layout_margin="20dp"
            android:layout_marginTop="-50dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A237E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a service to continue"
                android:textSize="14sp"
                android:textColor="#607D8B"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergencyLoan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Emergency Loan"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="16dp"
                app:elevation="6dp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpecialLoan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Special Loan"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#00796B"
                app:cornerRadius="16dp"
                app:elevation="6dp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegularLoan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Regular Loan"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#1565C0"
                app:cornerRadius="16dp"
                app:elevation="6dp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoanStatus"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="View Loan Status"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="16dp"
                app:elevation="6dp"
                android:layout_marginBottom="24dp"/>

            <!-- Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Logout"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="#455A64"
                app:cornerRadius="14dp"
                app:elevation="4dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
